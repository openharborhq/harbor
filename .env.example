# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://harbor:harbor@localhost:5432/harbor
REDIS_URL=redis://localhost:6379
# Path to the 32-byte master key file (generated by `pnpm setup:kek`). Never store the key in env.
HARBOR_KEK_FILE=./data/secrets/kek
HARBOR_DATA_DIR=./data
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
# Host ports for compose-managed Postgres/Redis (change if 5432/6379 are busy locally)
HARBOR_PG_PORT=5432
HARBOR_REDIS_PORT=6379
# OCR worker
OCR_CONCURRENCY=2
OCR_LANGUAGES=deu+eng
# Suggestions (spec §5). Pick one of three:
#   none              heuristics only — nothing leaves the box
#   anthropic         Claude; needs ANTHROPIC_API_KEY_FILE or ANTHROPIC_API_KEY
#   openai-compatible any /v1/chat/completions server; needs SUGGEST_BASE_URL, and a key only if
#                     the server wants one. Pointed at Ollama on the LAN, nothing leaves the box either.
SUGGEST_PROVIDER=none
SUGGEST_MODEL=claude-opus-5
# openai-compatible examples:
#   SUGGEST_BASE_URL=http://ollama:11434/v1   SUGGEST_MODEL=llama3.1:8b        (local, no key)
#   SUGGEST_BASE_URL=https://api.openai.com/v1  SUGGEST_MODEL=gpt-5           + SUGGEST_API_KEY
#   SUGGEST_BASE_URL=https://api.groq.com/openai/v1                            + SUGGEST_API_KEY
SUGGEST_BASE_URL=
SUGGEST_API_KEY=
SUGGEST_SEND_PEOPLE=true
SUGGEST_READER_LANGUAGE=en

# Email connections (spec §7). Credentials live in the database, sealed under the KEK — not here.
# How often mailfetch sweeps every connection, in seconds.
MAIL_SYNC_INTERVAL_SECONDS=300
# Only for a self-hosted IMAP server or Proton Bridge with a certificate the system does not trust.
NODE_EXTRA_CA_CERTS=

# Backups (spec §3.4). The backup container needs a restic repository; unset means "not configured"
# and Settings says so. One of:
#   b2:bucket:/path  + B2_ACCOUNT_ID/B2_ACCOUNT_KEY      sftp:user@host:/path      s3:…
#   /backup — a second disk mounted via HARBOR_BACKUP_DIR (a backup on the data disk is not a backup)
RESTIC_REPOSITORY=
HARBOR_BACKUP_DIR=./data/backup
# Running dist/backup.js outside Docker: the password file the container gets as a secret.
RESTIC_PASSWORD_FILE=./data/secrets/restic-password
BACKUP_HOUR=3
BACKUP_RESTORE_TEST_DAY=1
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
# false for a repository key that cannot delete (see docs/deploy.md); prune from elsewhere then.
BACKUP_PRUNE=true
TZ=UTC

# Tailnet-only networking (spec §3.2), used by infra/compose.tailscale.yml. With that overlay no
# container publishes a host port; without it, the web port is published on HARBOR_BIND below.
TS_AUTHKEY=
TAILSCALE_HOSTNAME=harbor
# Where the web port is published when NOT using the tailscale overlay. Loopback by default.
HARBOR_BIND=127.0.0.1
