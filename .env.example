# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://trustworthier:trustworthier@localhost:5432/trustworthier
REDIS_URL=redis://localhost:6379
# Path to the 32-byte master key file (generated by `pnpm setup:kek`). Never store the key in env.
TW_KEK_FILE=./data/secrets/kek
TW_DATA_DIR=./data
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
# Host ports for compose-managed Postgres/Redis (change if 5432/6379 are busy locally)
TW_PG_PORT=5432
TW_REDIS_PORT=6379
# OCR worker
OCR_CONCURRENCY=2
OCR_LANGUAGES=deu+eng
# Suggestions (spec §5). none = heuristics only. anthropic needs ANTHROPIC_API_KEY_FILE or ANTHROPIC_API_KEY.
SUGGEST_PROVIDER=none
SUGGEST_MODEL=claude-opus-5
SUGGEST_SEND_PEOPLE=true
SUGGEST_READER_LANGUAGE=en
