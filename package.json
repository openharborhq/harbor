{
  "name": "harbor",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "scripts/dev.sh",
    "dev:worker": "pnpm --filter @harbor/api start:worker:dev",
    "dev:suggester": "pnpm --filter @harbor/api start:suggester:dev",
    "dev:mailfetch": "pnpm --filter @harbor/api start:mailfetch:dev",
    "dev:backup": "pnpm --filter @harbor/api start:backup:dev",
    "suggest:rerun": "pnpm --filter @harbor/api start:suggester:rerun",
    "seed:demo": "pnpm --filter @harbor/api seed:dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @harbor/db generate",
    "db:migrate": "pnpm --filter @harbor/db migrate",
    "infra:up": "docker compose --env-file .env -f infra/compose.yml up -d postgres redis",
    "infra:down": "docker compose --env-file .env -f infra/compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/compose.yml logs -f"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
